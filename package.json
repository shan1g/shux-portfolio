{
  "name": "shux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "styles:build": "lessc app/styles/main.less app/styles/main.css",
    "styles:watch": "less-watch-compiler app/styles app/styles main.less",
    "dev": "npm run styles:build && concurrently \"npm run styles:watch\" \"next dev\"",
    "build": "npm run styles:build && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hashintel/refractive": "^0.0.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "less": "^4.9.0",
    "less-watch-compiler": "^1.19.9",
    "typescript": "^5"
  }
}
